          "required": true,
          "ref": null,
          "options": [],
          "min": null,
          "max": null
        },
        {
          "key": "sku",
          "label": "样品 SKU",
          "type": "text",
          "required": true,
          "ref": null,
          "options": [],
          "min": null,
          "max": null
